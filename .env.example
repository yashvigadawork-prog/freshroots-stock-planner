# Copy to .env.local to try things on your own computer. Never commit real values.

# Database: leave empty locally (a built-in database is used). On Vercel, add your Neon connection string here.
DATABASE_URL=

# Zoho (see the Zoho connection screen for step-by-step help). Leave empty until Zoho is set up.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
# India is "in". Others: com, eu, com.au, jp, ca
ZOHO_DC=in
